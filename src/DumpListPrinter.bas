1 "1" X=INT(V/16): GOSUB "2": D$=A$, X=V-INT(V/16)*16: GOSUB "2": D$=D$+A$: RETURN
2 "2" IF X>9 LET A$=CHR$ (55+X): RETURN
3 A$=STR$ X: RETURN
10 "A" CLEAR: DIM W$(0)*24: INPUT "S ADDR=";S: INPUT "E ADDR=";E: Z=E-S: IF Z<0 PRINT "ERROR.": GOTO 10
20 FOR I=0 TO INT(Z/8): V=INT(S/256): GOSUB "1": W$(0)=D$, V=S-INT(S/256)*256: GOSUB "1": W$(0)=W$(0)+D$+" "
30 C=0: FOR J=0 TO 7: V=PEEK(S): S=S+1, C=C+V: GOSUB "1": W$(0)=W$(0)+D$: IF C>255 LET C=C-255
40 NEXT J: V=C: GOSUB "1": W$(0)=W$(0)+":"+D$: LPRINT W$(0): NEXT I: LPRINT "": BEEP 1: END

